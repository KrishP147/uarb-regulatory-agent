# AgentMail (https://console.agentmail.to): key needs inbox read/write + message send
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=         # from: python agent.py --create-inbox <name>
# Claude: loose-wording/thread parsing + the "what these documents cover" summary (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# S3-compatible storage for ZIPs over AgentMail's 6 MB inline limit (AWS S3, Supabase Storage, R2, ...)
S3_BUCKET=
S3_ENDPOINT=                # blank for AWS S3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
